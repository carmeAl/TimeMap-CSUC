          },
          "hide": false,
          "query": "\r\nfrom(bucket: v.defaultBucket)\r\n  |> range(start: v.timeRangeStart, stop:v.timeRangeStop)\r\n  |> drop(columns: [\"host\", \"src_ip\", \"dst_ip\", \"dst\", \"src\"])  \r\n  |> filter(fn: (r) =>\r\n    r._measurement == \"exec_snmp\" and r.src_short == \"${src}\" and r.dst_short == \"${outgoing}\" \r\n  )\r\n  |> filter(fn: (r) => r[\"_field\"] == \"roundTripTimeMin\" or r[\"_field\"] == \"roundTripTimeAverage\" or r[\"_field\"] == \"roundTripTimeMax\"\r\n  )\r\n\r\n\r\n",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "influxdb",
            "uid": "${DS_INFLUXDB}"
          },
          "hide": false,
          "query": "import \"join\"\r\nimport \"math\"\r\n\r\nd = from(bucket: v.defaultBucket)\r\n  |> range(start: v.timeRangeStart, stop:v.timeRangeStop)\r\n  |> drop(columns: [\"host\", \"src_ip\", \"dst_ip\", \"dst\", \"src\"])  \r\n  |> filter(fn: (r) =>\r\n    r._measurement == \"exec_snmp\" and r.src_short == \"${src}\" and r.dst_short == \"${outgoing}\" \r\n  )\r\n  |> filter(fn: (r) => r[\"_field\"] == \"roundTripTimeMin\" or r[\"_field\"] == \"roundTripTimeAverage\" or r[\"_field\"] == \"roundTripTimeMax\"\r\n  )\r\n\r\n\r\n\r\nmad = (table=<-, threshold=1.0) => {\r\n    med = table |> group()\r\n      |> group(columns: [\"_field\"]) \r\n      |> median(column: \"_value\")\r\n      |> group()\r\n    d_with_diff = join.inner(\r\n            left: table |> group(),\r\n            right: med,\r\n            on: (l, r) => l._field==r._field,\r\n            as: (l, r) => ({l with med: r._value, diff: math.abs(x: l._value - r._value) }),\r\n        )\r\n    norm_mad = d_with_diff \r\n      |> group(columns: [\"_field\"])\r\n      |> median(column: \"diff\")\r\n      |> map(fn: (r) => ({ r with mad: 1.4826*r.diff}))\r\n      |> group()\r\n      |> drop(columns: [\"diff\"])\r\n\r\n    return join.inner(\r\n            left: d_with_diff,\r\n            right: norm_mad,\r\n            on: (l, r) => l._field==r._field,\r\n            as: (l, r) => ({l with score: if r.mad > 0.0 then l.diff/r.mad else 0.0}),\r\n        )\r\n        |> map(fn: (r) => ({ r with anomaly: if r.score > threshold then 1 else 0 }))\r\n}\r\n\r\nd |> mad(threshold:6)\r\n  |> filter(fn: (r) => r.anomaly >0 )\r\n  |> keep(columns: [\"_time\",\"_field\",\"_value\"])\r\n  |> rename(columns: {_value: \"Anomaly\"})\r\n  |> group(columns: [\"_field\"])\r\n  \r\n",
          "refId": "Anomaly"
        }
      ],
