          "query": "d=from(bucket: v.defaultBucket)\r\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\r\n  |> filter(fn: (r) => r[\"_measurement\"] == \"exec_snmp\")\r\n  |> aggregateWindow(every: 1h, fn: last, createEmpty: false)\r\n  |> group(columns: [\"src_short\", \"dst_short\"])\r\n  |> pivot(rowKey: [\"_time\"], columnKey: [\"_field\"], valueColumn: \"_value\")\r\n  |> last(column:\"_time\")\r\n  |> group()\r\n  |> drop(columns:[\"dst_latitude\",\"dst_longitude\",\"src_latitude\",\"src_longitude\"])\r\n  |> filter(fn: (r) => r[\"src_short\"] == \"${src}\" or r[\"dst_short\"] == \"${src}\" )\r\n  |> rename(columns: {src_short: \"source\", dst_short: \"target\"})\r\n  |> map(fn: (r) => ({ r with id: string(v: r[\"source\"]+\"--\"+r[\"target\"]) }))\r\n  |> filter(fn: (r) => exists r[\"id\"] )\r\n\r\n\r\nd \r\n  |> map(fn: (r) => ({ r with mainstat: \"Jitter: \" + string(v: r[\"posRttJitterMax\"]) + \"ms\" }))\r\n  |> map(fn: (r) => ({ r with secondarystat: \"RTT: \" + string(v: r[\"roundTripTimeMax\"]) +\"ms\" }))\r\n\r\n",
